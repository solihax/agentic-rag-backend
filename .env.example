# Copy this file to a new file named ".env" in the same folder,
# then fill in your real values. NEVER commit the real ".env" file to git.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Your Gemini proxy API key (from your mentor)
GEMINI_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Web Search (Tavily) - free tier available at tavily.com
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_key_here

# ---------------------------------------------------------------------------
# Vector Database (Qdrant) - "local" needs no extra setup
# ---------------------------------------------------------------------------
QDRANT_MODE=local
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=agentic_rag_documents

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
